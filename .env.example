# Copy to .env and fill. Never commit secrets.

# --- Default LLM (analyze / chain / fallback) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# --- Ensemble map: A / B / C (can be different providers) ---
# Suggested assignment:
#   A = DeepSeek flash (fast first vote)
#   B = GLM-4-Flash (second independent vote)
#   C = Kimi (tie-breaker; lower RPM → call less often)

MAP_MODEL_A=deepseek-flash
MAP_BASE_URL_A=https://api.deepseek.com
MAP_API_KEY_ENV_A=LLM_API_KEY

MAP_MODEL_B=GLM-4-Flash
MAP_BASE_URL_B=https://open.bigmodel.cn/api/paas/v4
MAP_API_KEY_ENV_B=ZHIPU_API_KEY
ZHIPU_API_KEY=

MAP_MODEL_C=kimi-k2.6
MAP_BASE_URL_C=https://api.moonshot.cn/v1
MAP_API_KEY_ENV_C=KIMI_API_KEY
KIMI_API_KEY=

# Optional for GitHub API listing
GITHUB_TOKEN=
